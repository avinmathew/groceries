// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ShoppingList {
  id              String   @id @default(cuid())
  name            String
  refreshStatus   String   @default("idle") // idle, refreshing
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items ShoppingListItem[]

  @@map("shopping_lists")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groceryItems GroceryItem[]

  @@map("categories")
}

model GroceryItem {
  id            String   @id @default(cuid())
  name          String
  categoryId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productLinks     ProductLink[]
  shoppingListItems ShoppingListItem[]

  @@map("grocery_items")
}

model ShoppingListItem {
  id            String   @id @default(cuid())
  quantity      Int      @default(1)
  notes         String?
  status        String   @default("active") // "active" | "watchlisted" | "completed"
  completedAt   DateTime?
  groceryItemId String
  shoppingListId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  groceryItem  GroceryItem  @relation(fields: [groceryItemId], references: [id], onDelete: Cascade)
  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@unique([groceryItemId, shoppingListId])
  @@map("shopping_list_items")
}

model GroceryUsage {
  id            String   @id @default(cuid())
  name          String   @unique
  score         Float    @default(0)
  lastDecayedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("grocery_usage")
}

model ProductLink {
  id            String   @id @default(cuid())
  url           String
  store         String   // "woolworths" | "coles" | "aldi"
  label         String?
  perUnit       Float?
  regularPrice  Float?
  discountPrice Float?
  lastRefreshed DateTime?
  groceryItemId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  groceryItem   GroceryItem @relation(fields: [groceryItemId], references: [id], onDelete: Cascade)
  priceHistory  PriceHistory[]

  @@map("product_links")
}

model PriceHistory {
  id            String   @id @default(cuid())
  regularPrice  Float?
  discountPrice Float?
  recordedAt    DateTime @default(now())
  productLinkId String
  createdAt     DateTime @default(now())

  productLink   ProductLink @relation(fields: [productLinkId], references: [id], onDelete: Cascade)

  @@index([productLinkId, recordedAt])
  @@map("price_history")
}
